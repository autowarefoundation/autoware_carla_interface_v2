<launch>
  <!--
    Autoware as the ECU under test of autoware_carla_scenario's HILS bridge
    (scenario-hils, docs/hils.md): resident, on the HILS PC, on wall-clock time.

      scenario-hils config/hils/scenario-hils.yaml     (the bridge)
      ros2 launch autoware_carla_interface_v2 autoware_hils.launch.xml map_path:=... goal_x:=... goal_y:=... goal_yaw:=...
      uv run scenario ego.entity=hils ...              (the run, on the simulation host)

    Autoware gets only what a car would give it: the vehicle CAN
    (config/hils/carla_autoware.dbc, through hils_vehicle_interface), a
    Tamagawa IMU on that CAN (config/hils/tamagawa_imu.dbc, decoded by
    Autoware's own tamagawa_imu_driver), a Septentrio GNSS receiver's SBF on
    TCP (septentrio_gnss_driver) and the Pandar XT32's UDP packets, decoded by
    Autoware's own LiDAR driver (nebula).

    map_path must be georeferenced as CARLA's geolocation is, for the GNSS:
      ros2 run autoware_carla_interface_v2 hils_geo_map <CARLA level map> <output>
  -->
  <arg name="map_path" description="Autoware map directory of the scenario's level"/>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="sensor_model" default="awsim_sensor_kit"/>
  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models"/>
  <arg name="rviz" default="false"/>
  <arg name="can_url" default="can://vcan0" description="The vehicle CAN the bridge writes (scenario-hils.yaml's vehicle_can)"/>
  <arg name="imu_can_interface" default="vcan0" description="The CAN the bridge writes the Tamagawa IMU's frames to (scenario-hils.yaml's imu_can)"/>
  <arg name="imu_frame_id" default="tamagawa/imu_link" description="The IMU's frame in the sensor kit, which the bridge sends its values in"/>
  <arg name="gnss_param_path" default="$(find-pkg-share autoware_carla_interface_v2)/config/hils/septentrio_gnss.param.yaml"
       description="septentrio_gnss_driver parameters: the bridge's SBF stream on TCP, NavSatFix only"/>
  <arg name="lidar_host_ip" default="127.0.0.1" description="Where the LiDAR packets arrive"/>
  <arg name="lidar_sensor_ip" default="127.0.0.1" description="Where they come from (the bridge)"/>
  <arg name="lidar_data_port" default="2368"/>
  <arg name="goal_set" default="false" description="Set a route to goal_x/y/yaw when the ignition comes on"/>
  <arg name="goal_x" default="0.0"/>
  <arg name="goal_y" default="0.0"/>
  <arg name="goal_yaw" default="0.0"/>
  <arg name="auto_engage" default="true"/>
  <arg name="ekf_param_path" default="$(find-pkg-share autoware_carla_interface_v2)/config/hils/ekf_localizer.param.yaml"
       description="EKF parameters; the HILS one keeps each NDT pose a little longer than one LiDAR period"/>

  <!-- The LiDAR: Autoware's own driver, on the bridge's Pandar XT32 packets -->
  <group>
    <push-ros-namespace namespace="/sensing/lidar/top"/>
    <node pkg="nebula_hesai" exec="hesai_ros_wrapper_node" name="hesai_ros_wrapper_node" output="screen">
      <param from="$(find-pkg-share nebula_hesai)/config/PandarXT32.param.yaml" allow_substs="true"/>
      <param name="host_ip" value="$(var lidar_host_ip)"/>
      <param name="sensor_ip" value="$(var lidar_sensor_ip)"/>
      <param name="data_port" value="$(var lidar_data_port)"/>
      <!-- Points in the Hesai frame (y forward); the bridge mounts the sensor so that this is velodyne_top -->
      <param name="frame_id" value="velodyne_top"/>
      <param name="launch_hw" value="true"/>
      <param name="setup_sensor" value="false"/>
      <param name="udp_only" value="true"/>
      <param name="calibration_download_enabled" value="false"/>
      <!-- Explicit: the param file's $(var sensor_model) would pick up this launch's sensor kit name -->
      <param name="calibration_file" value="$(find-pkg-share nebula_hesai_decoders)/calibration/PandarXT32.csv"/>
      <param name="return_mode" value="Strongest"/>
      <!-- pandar_points is PointXYZIRCAEDT, what Autoware's preprocessing reads -->
      <remap from="pandar_points" to="pointcloud_raw_ex"/>
    </node>
  </group>

  <!-- The IMU: Autoware's own driver, on the bridge's Tamagawa CAN frames -->
  <group>
    <push-ros-namespace namespace="/sensing/imu"/>
    <!-- Only the IMU's frames (0x319, 0x31A); the rest of the bus is the vehicle interface's -->
    <include file="$(find-pkg-share ros2_socketcan)/launch/socket_can_receiver.launch.py">
      <arg name="interface" value="$(var imu_can_interface)"/>
      <arg name="filters" value="319:7FF,31A:7FF"/>
      <arg name="from_can_bus_topic" value="/can/imu"/>
    </include>
    <node pkg="tamagawa_imu_driver" exec="tag_can_driver" name="tag_can_driver" output="screen">
      <param name="imu_frame_id" value="$(var imu_frame_id)"/>
      <remap from="imu/data_raw" to="/sensing/imu/tamagawa/imu_raw"/>
    </node>
  </group>

  <!-- The GNSS: Autoware's own driver, on the bridge's Septentrio SBF stream.
       Its NavSatFix goes where the sensor kit's gnss_poser reads it. -->
  <node pkg="septentrio_gnss_driver" exec="septentrio_gnss_driver_node" name="septentrio_gnss_driver" output="screen">
    <param from="$(var gnss_param_path)"/>
    <remap from="navsatfix" to="/sensing/gnss/ublox/nav_sat_fix"/>
  </node>

  <!-- The vehicle interface: the CAN on Autoware's side -->
  <node pkg="autoware_carla_interface_v2" exec="hils_vehicle_interface" name="hils_vehicle_interface" output="screen">
    <param name="can_url" value="$(var can_url)"/>
    <param name="goal_set" value="$(var goal_set)"/>
    <param name="goal_x" value="$(var goal_x)"/>
    <param name="goal_y" value="$(var goal_y)"/>
    <param name="goal_yaw" value="$(var goal_yaw)"/>
    <param name="auto_engage" value="$(var auto_engage)"/>
  </node>

  <!-- Autoware, without a simulator interface: the vehicle is on the CAN -->
  <!-- Read by pose_twist_fusion_filter.launch.xml, which the localization component includes without arguments -->
  <let name="ekf_localizer_param_path" value="$(var ekf_param_path)"/>
  <include file="$(find-pkg-share autoware_launch)/launch/e2e_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="simulator_type" value="carla"/>
    <arg name="launch_simulator_interface" value="false"/>
    <arg name="use_sim_time" value="false"/>
    <arg name="rviz" value="$(var rviz)"/>
  </include>
</launch>
