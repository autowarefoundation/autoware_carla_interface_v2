VERSION ""

NS_ :

BS_:

BU_: SIM ADS

BO_ 256 VehicleStatus: 8 SIM
 SG_ Speed : 0|16@1- (0.01,0) [-327.68|327.67] "m/s" ADS
 SG_ Steer : 16|16@1- (0.0001,0) [-1|1] "" ADS
 SG_ Gear : 32|8@1- (1,0) [-128|127] "" ADS
 SG_ Reverse : 40|1@1+ (1,0) [0|1] "" ADS
 SG_ HandBrake : 41|1@1+ (1,0) [0|1] "" ADS
 SG_ YawRate : 48|16@1- (0.0001,0) [-3.2768|3.2767] "rad/s" ADS

BO_ 272 PowerMode: 8 SIM
 SG_ Ignition : 0|1@1+ (1,0) [0|1] "" ADS

BO_ 512 ControlCmd: 8 ADS
 SG_ TargetSpeed : 0|16@1- (0.01,0) [-327.68|327.67] "m/s" SIM
 SG_ Accel : 16|16@1- (0.001,0) [-32.768|32.767] "m/s2" SIM
 SG_ SteerAngle : 32|16@1- (0.0001,0) [-3.2768|3.2767] "rad" SIM
 SG_ Jerk : 48|16@1- (0.001,0) [-32.768|32.767] "m/s3" SIM

BO_ 528 EcuStatus: 8 ADS
 SG_ Ready : 0|1@1+ (1,0) [0|1] "" SIM
 SG_ Engaged : 1|1@1+ (1,0) [0|1] "" SIM

CM_ BO_ 256 "Ego state, from scenario-hils signals: Speed = longitudinal_velocity, Steer = CARLA steer (positive right), YawRate = the vehicle's own yaw rate (counter-clockwise positive), as a vehicle's ESC reports it.";
CM_ BO_ 512 "Autoware control_cmd as CARLA Ackermann control: TargetSpeed signed (negative = reverse), SteerAngle left-positive tire angle.";
